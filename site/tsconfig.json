{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": {
      "@algos/mergeIntervals/mergeIntervals": ["./src/overrides/algos-mergeIntervals.d.ts"],
      "@algos/*": ["../src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
